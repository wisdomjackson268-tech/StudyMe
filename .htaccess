# StudyMe AI Platform — Apache Production Configuration & SEO Routing
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /StudyMe/

    # Security: Protect sensitive directories and files
    RewriteRule ^(config|storage|database|includes)/ - [F,L,NC]
    RewriteRule (^|/)\.(env|git) - [F,L,NC]
    RewriteRule \.(sql|log|ini|env|env\..*|bak)$ - [F,L,NC]

    # Sitemap Rewrite
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^robots\.txt$ robots.txt [L]

    # Clean Course URLs with category prefix
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^courses/technology/([a-zA-Z0-9_-]+)/?$ courses/details.php?slug=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^courses/university/([a-zA-Z0-9_-]+)/?$ courses/details.php?slug=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^courses/secondary/([a-zA-Z0-9_-]+)/?$ courses/details.php?slug=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^courses/teacher/([a-zA-Z0-9_-]+)/?$ courses/details.php?slug=$1 [L,QSA]

    # Clean Direct Course URLs
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^courses/([a-zA-Z0-9_-]+)/?$ courses/details.php?slug=$1 [L,QSA]
</IfModule>

# Custom Error Pages
ErrorDocument 404 /StudyMe/404.php
ErrorDocument 403 /StudyMe/403.php
ErrorDocument 500 /StudyMe/500.php

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Browser Caching for Performance & Core Web Vitals
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType font/woff2 "access plus 1 month"
    ExpiresByType font/woff "access plus 1 month"
</IfModule>
