# ==============================================================================
# StudyMe AI-Powered Platform — Environment Configuration Template
# 
# Instructions:
# 1. Copy this file to '.env' in your project root: copy .env.example .env
# 2. Add your OpenAI API key and other local environment settings in '.env'.
# 3. NEVER commit '.env' to version control or expose it to client-side scripts.
# ==============================================================================

# Application Environment
APP_NAME=StudyMe
APP_ENV=development
APP_URL=http://localhost/StudyMe

# Gmail SMTP (use a Google App Password, not your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=studyme910@gmail.com
SMTP_PASS=your_16_character_google_app_password

# Google Gemini AI Learning Assistant Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ALOC Station Past Questions API Configuration (JAMB, WAEC, NECO)
ALOC_API_KEY=your_aloc_api_key_here
ALOC_BASE_URL=https://questions.aloc.com.ng/api/v2
